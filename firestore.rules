    // ks = the doc's keys (create, extra = 'createdBy'; createdBy == uid() is required there) or the
    // changed keys (update, extra = 'title'). 1.3.7: createdBy is only allowed on create, so no update can
    // change it (this replaced the scorer's createdBy comparison: the 12-a-side finishing write and the
    // 12-a-side create are at the 1000-expression budget).
    // 1.4.1 (QA V140-8): 'createdAt' is no longer a match key – refused on create and on update at no extra
    // expression cost (the 12-a-side create sits at the 1000-expression budget, so a time-window check didn't
    // fit). The app stopped writing it; a match's date comes from its finish/start/scheduled time, and older
    // docs keep the createdAt they have (it can't be changed).
    function matchKeysOk(ks, extra) {
      return ks.hasOnly([extra, 'title', 'teamA', 'teamB', 'rules', 'firstServe', 'events', 'summary', 'status',
            'scorerId', 'participantIds', 'location', 'scheduledAt', 'startedAt', 'finishedAt', 'tournamentId', 'fixtureId',
            'challengeId', 'stream', 'interestedIds', 'lineups', 'playerOfMatchId', 'updatedAt', 'serverUpdatedAt',
            'finishedServerAt', 'captains', 'verification', 'startedServerAt', 'teamSizeMode', 'maxEvents', 'wasWon', 'abandon']);
    }
    // 1.3.7 (1.3.6 team size): 'exact' = at most 6 per side (exactly 6 once scoring starts, with
    // enoughPlayers), 'custom' or missing (matches before 1.3.6) = up to maxPlayers().
    // Must match core/roster.ts maxPlayersFor (rules-tests check it).
    function teamSizeOk(d) {
      // 1.3.7: kept cheap (the worst-case create sits close to the 1000-expression budget).
      return d.get('teamSizeMode', 'custom') == 'custom'
        || (d.teamSizeMode == 'exact' && d.teamA.players.size() <= 6 && d.teamB.players.size() <= 6);
    }
    function timesOk(d) {
      let st = d.get('startedAt', null);
      let fin = d.get('finishedAt', null);
      // QA G13: a match can't finish before it started. (?: instead of ||, which evaluates both sides.)
      return fin == null ? (st == null ? true : msOk(st))
        : (msOk(fin) && (st == null ? true : (msOk(st) && fin >= st)));
    }
    function scheduledOk(d) {
      let at = d.get('scheduledAt', null);
      // QA G9: a newly scheduled time can't already be over (15 min grace).
      return at == null || (schedMsOk(at) && (d.status != 'scheduled' || at >= nowMs() - 900000));
    }
    // 1.4.2 (QA V141-7): a newly set scheduled time is at most 2 years (2 x 366 days) ahead
    // (src/core/validate.ts MAX_SCHEDULE_AHEAD_MS); floats such as 1e300 already fail `is int`.
    function schedMsOk(v) { return msOk(v) && v <= nowMs() + 63244800000; }
    // Fields other than the roster and the score (title, rules, times, links, place).
    function matchMetaOk(d, ks) {
      return (ks.hasAny(['title']) ? titleOk(d.get('title', null)) : true)
        && (ks.hasAny(['rules']) ? rulesOk(d.rules) : true)
        && d.status in ['scheduled', 'live', 'finished', 'abandoned']
        // finish times (QA NB-R3) and 'finished' needs a winner (QA NB-R2, a status-only write)
        && (ks.hasAny(['status']) ? finishTimesOk(d) && statusMoveOk(d, ks) : !ks.hasAny(['finishedAt', 'finishedServerAt']))
        && (ks.hasAny(['startedAt', 'startedServerAt']) ? startTimesOk(d) : true)
        && d.get('firstServe', 'A') in ['A', 'B']
        && timesOk(d)
        // (?: first on the status, so a finishing write doesn't pay for the schedule check)
        && (d.status == 'scheduled' ? (ks.hasAny(['scheduledAt', 'status']) ? scheduledOk(d) : true)
            : (ks.hasAny(['scheduledAt']) ? (d.get('scheduledAt', null) == null || schedMsOk(d.scheduledAt)) : true))
        && (ks.hasAny(['location']) ? d.get('location', null) == null || placeOk(d.location) : true)
        && (ks.hasAny(['tournamentId', 'challengeId', 'fixtureId'])
            ? [d.get('tournamentId', null), d.get('challengeId', null), d.get('fixtureId', null)].removeAll([null]).join('|').matches('^[A-Za-z0-9_|-]{0,200}$')
            : true);
    }
    // New match: no events yet, valid metadata.
    // 1.4.4 (QA V143-5): the app's real creates (immediate start by number at 6 and 12 a side, team matches with a
    // title and place, scheduled by-number matches with title, place and time) went over the 1000-expression budget.
    // The create path is now cheaper (rules-tests "V143-5" build every shape with the app's own builder,
    // src/core/buildMatch.ts + src/services/backend/firebaseMatchDoc.ts, and check the headroom):
    //  - its own key list (matchCreateKeysOk): no finish/POTM/verification/server-update key can be sent at all,
    //    so they need no value checks;
    //  - the summary is not checked at create (the stored summary is untrusted, the app replays the events, and
    //    `events == []` already says 0-0);
    //  - a live match must carry its start (startedServerAt = request.time, startedAt within 5 min – every app
    //    version since 1.3.0 sends both), a scheduled one carries none and a start time that isn't over (QA G9,
    //    15 min grace) and at most 2 years ahead (schedMsOk). A live match's scheduledAt (= its start) is only
    //    type-checked.
    // The update rule is separate (allow update) and isn't evaluated for a create.
    function matchCreateKeysOk(ks) {
      return ks.hasOnly(['createdBy', 'title', 'teamA', 'teamB', 'rules', 'firstServe', 'events', 'summary', 'status',
            'scorerId', 'participantIds', 'location', 'scheduledAt', 'startedAt', 'finishedAt', 'tournamentId', 'fixtureId',
            'challengeId', 'stream', 'interestedIds', 'updatedAt', 'captains', 'startedServerAt', 'teamSizeMode']);
    }
    function matchCreateOk(d) {
      let ks = d.keys();
      let at = d.get('scheduledAt', null);
      return matchCreateKeysOk(ks) && teamSizeOk(d)
        && d.events == []
        && d.firstServe in ['A', 'B']
        && d.get('finishedAt', null) == null
        && (d.status == 'live'
          ? d.startedServerAt == request.time && d.startedAt >= nowMs() - 300000 && d.startedAt <= nowMs() + 300000
            && (at == null || at is int)
          : d.status == 'scheduled' && !ks.hasAny(['startedServerAt', 'startedAt'])
            && (at == null || (schedMsOk(at) && at >= nowMs() - 900000)))
        && rulesOk(d.rules)
        && titleOk(d.get('title', null))
        && (d.get('location', null) == null || placeOk(d.location));
    }
    // Update: only the groups of fields being written are checked, so a roster change or a rally
    // costs a couple of expressions here and an older document can still be scored or closed.
    // Player of the Match (src/core/potm.ts potmProblem): set once, by the scorer, on a match that
    // is ALREADY finished (stored status), within 24 h of the stored finish, to a player of team A
    // or B (participantIds[0:n] are exactly the players, see participantsOk).
    // QA NB-R3 (retest 1.1.0): it is locked once set – never changed or cleared, also when the
    // winning rally is undone (the match re-opens with its POTM kept) – and the write that sets it
    // can't touch the finish times, the status or the events, so the 24 h window can't be moved.
    // The window runs from finishedServerAt (request.time of the finishing write) when present,
    // else (older documents) from the stored finishedAt.
    function potmOk(d, ks) {
      let r = resource.data;
      return r.scorerId == uid() && d.scorerId == uid()
        && r.get('playerOfMatchId', null) == null && d.playerOfMatchId != null
        && r.status == 'finished' && d.status == 'finished'
        && !ks.hasAny(['finishedAt', 'finishedServerAt', 'status', 'events', 'summary'])
        && (r.get('finishedServerAt', null) != null
              ? request.time < r.finishedServerAt + duration.value(24, 'h')
              : (r.get('finishedAt', null) is int && nowMs() - r.finishedAt < 86400000))
        && d.playerOfMatchId in d.participantIds[0:d.teamA.players.size() + d.teamB.players.size()];
    }
    // 1.3.0 terminal statuses only move one way (src/core/antifraud.ts statusMoveOk): scheduled ->
    // live/abandoned; live -> finished/abandoned (or back to scheduled before the first rally);
    // finished -> nothing (1.4.2, V141-8; before: back to live by undo until the POTM was picked);
    // abandoned -> nothing. (Update only: create has its own status check.)
    function statusMoveOk(d, ks) {
      // (only called when the status changed)
      let from = resource.data.status;
      return d.status == 'finished' ? from == 'live'
          // scheduled -> live must stamp the server start (QA N121-3; startTimesOk checks the value)
          // 1.4.2 (QA V141-8): never finished -> live (no undo after the end)
          : d.status == 'live' ? (from == 'scheduled' && d.get('startedServerAt', null) == request.time)
          // 1.4.5 (V144-1): scorerAbandonOk (maxEvents, wasWon, the record / policy)
          : d.status == 'abandoned' ? from in ['scheduled', 'live'] && scorerAbandonOk(d, ks)
          // live -> scheduled before the first rally clears the start
          // 1.4.6 (QA V145-1): only if the match NEVER had a rally (maxEvents – undo to 0 doesn't count)
          : (from == 'live' && maxEv(resource.data) == 0 && d.get('events', []).size() == 0
            && d.get('startedServerAt', null) == null && d.get('startedAt', null) == null);
    }
    // Server time only (QA AF-14/AF-17): startedAt/startedServerAt are written once, when the match
    // goes live (startedServerAt = request.time; startedAt within 5 minutes of it), and cleared when it
    // goes back to scheduled. Never backdated afterwards.
    function startTimesOk(d) {
      return d.status == 'scheduled'
        ? d.get('startedAt', null) == null && d.get('startedServerAt', null) == null
        : resource.data.get('startedServerAt', null) == null && resource.data.get('startedAt', null) == null
          && d.status == 'live' && d.get('startedServerAt', null) == request.time
          && d.startedAt is int && d.startedAt >= nowMs() - 300000 && d.startedAt <= nowMs() + 300000;
    }

    // ---------- result confirmation (1.3.0, src/core/antifraud.ts confirmProblem) ----------
    // x plays for side A / B (participantIds start with exactly team A's then team B's players).
    function onSide(r, sideIsA, x) {
      return x in (sideIsA ? r.participantIds[0:r.teamA.players.size()]
        : r.participantIds[r.teamA.players.size():r.teamA.players.size() + r.teamB.players.size()]);
    }
    // 1.4.4: no summary.winner here (the stored summary is untrusted): the app only offers the confirm / review on a
    // match whose replayed events have a winner (core/antifraud.ts isCompleted → matchWinner), and a match without
    // one never counts, whatever is confirmed (countMatches replays it as well).
    function completed(r) {
      return r.status == 'finished' && r.get('playerOfMatchId', null) != null;
    }
    function vStatus(r) { return r.get('verification', {'status': 'pending'}).get('status', 'pending'); }
    // The opposing captain: a captain who is not the scorer or the creator, and not on their side.
    // Only from pending, once, writing only verification = {status, by: me, at: request.time, reason}.
    // 1.3.7 (F135-1): what an admin's approval means. false = it only clears the fraud flag; the match
    // counts once the opposing captain confirms. MUST equal ADMIN_APPROVAL.COUNTS_WITHOUT_CAPTAIN in
    // src/core/antifraud.ts (rules-tests check it). Counting itself is computed from these fields.
    function adminApprovalCounts() { return false; }
    function captainOf(r) { return r.get('verification', {}).get('captain', null); }
    // 1.4.5 (QA V144-8): measured against the scorer before any admin reassignment (scorerReassign.from)
    // A captain who gives the verdict (core/antifraud.ts verdictCaptains): not the scorer as at the first rally or the
    // creator, and on neither one's side.
    function verdictCapt(r, x) {
      let sc = r.get('scorerReassign', null) == null ? r.scorerId : r.scorerReassign.from;
      let c = r.get('captains', null);
      return c != null && x != sc && x != r.createdBy
        && (x == c.A ? !onSide(r, true, sc) && !onSide(r, true, r.createdBy)
          : (x == c.B && !onSide(r, false, sc) && !onSide(r, false, r.createdBy)));
    }
    // 1.4.8 (QA V147-2, core/verdictRepair.ts, lifecycle 'repairVerdict'): an admin outside the match repairs a match
    // nobody can confirm (scorerTargetOk fails now, passes after), with no captain verdict and no review yet: either a
    // participant becomes the scorer (scorerReassign removed: the verdict reference is that scorer) or a player of one
    // side becomes that side's captain. Audited in verdictRepair (by me, server time, what was there).
    function verdictRepairOk(d, ks) {
      let r = resource.data;
      let v = d.verdictRepair;
      let c = r.get('captains', null);
      // 1.4.10 (QA V149-3): scorerTargetOk can't see a captain who plays for the other team (it checks the captain's
      // slot, not the player's side), so a captain repair proves "broken" by that captain being off its side instead
      return isAdmin() && !ownMatch(r) && c != null && (v.kind == 'confirmer' || !scorerTargetOk(r)) && scorerTargetOk(d)
        && vStatus(r) == 'pending' && captainOf(r) == null
        && v.keys().hasOnly(['by', 'at', 'kind', 'to', 'side', 'prevScorer', 'prevFrom', 'prevCaptainA', 'prevCaptainB'])
        && v.by == uid() && v.at == request.time && v.prevScorer == r.scorerId
        && v.prevFrom == (r.get('scorerReassign', null) == null ? null : r.scorerReassign.get('from', null)) && v.prevCaptainA == c.A && v.prevCaptainB == c.B
        // 1.4.9 (QA V148-2): a scorer; 1.4.10 (QA V149-3): or a captain, only for a side whose stored captain doesn't
        // play for that side (core captainFixAllowed), replaced by a player of that side
        && (v.kind == 'scorer'
          ? ks.hasOnly(['verdictRepair', 'scorerId', 'scorerReassign', 'updatedAt']) && v.side == null && v.to == d.scorerId
            && d.scorerId in r.participantIds && d.get('scorerReassign', null) == null
          : v.kind == 'confirmer' && ks.hasOnly(['verdictRepair', 'captains', 'updatedAt']) && v.side in ['A', 'B']
            && d.captains.keys().hasOnly(['A', 'B'])
            && (v.side == 'A'
              ? d.captains.A == v.to && d.captains.B == c.B && !onSide(r, true, c.A) && onSide(r, true, v.to)
              : d.captains.B == v.to && d.captains.A == c.A && !onSide(r, false, c.B) && onSide(r, false, v.to)));
    }
    // 1.4.6: never the CURRENT scorer (V145-6), and a verdict belongs to the current re-open epoch (V145-2: `epoch`, only
    // written after a re-open, equals reopenEpoch).
    function confirmOk(r, v) {
      return completed(r) && verdictCapt(r, uid()) && uid() != r.scorerId
        && (vStatus(r) == 'pending' ? confirmFromPending(v) : confirmAfterApproval(r, v))
        && v.by == uid() && v.at == request.time && v.get('epoch', 0) == r.get('reopenEpoch', 0);
    }
    // verdict 'confirmed'/'rejected' must match the decision. 1.3.9 (V138-3): required on every new
    // answer (1.3.7+ clients always send it); a 1.3.6 client's answer without it is refused, so the
    // ambiguous older shape (approved + by, no reason, no verdict) can't be created any more.
    function verdictOk(v, decision) {
      return v.get('captain', null) == (decision == 'confirmed' ? 'confirmed' : 'rejected');
    }
    function confirmFromPending(v) {
      return v.keys().hasOnly(['status', 'by', 'at', 'reason', 'captain', 'epoch'])
        && v.status in ['confirmed', 'disputed'] && verdictOk(v, v.status)
        && (v.status == 'disputed' ? optTextOk(v.get('reason', null), 200) : v.get('reason', null) == null);
    }
    // 1.3.7: an admin cleared the flag before the captain answered: the status stays 'approved' and the
    // review fields stay as they were; the captain adds the verdict (once).
    function confirmAfterApproval(r, v) {
      let old = r.get('verification', {});
      return !adminApprovalCounts() && vStatus(r) == 'approved' && captainOf(r) == null && old.get('by', null) == null
        && v.keys().hasOnly(['status', 'by', 'at', 'reason', 'captain', 'reviewedBy', 'reviewedAt', 'epoch'])
        && v.status == 'approved' && v.get('captain', null) in ['confirmed', 'rejected']
        && v.get('reviewedBy', null) == old.get('reviewedBy', null) && v.get('reviewedAt', null) == old.get('reviewedAt', null)
        && (v.captain == 'rejected' ? optTextOk(v.get('reason', null), 200) : v.get('reason', null) == null);
    }
    // Admin review: approve (1.3.7: clears the flag; counting still needs the captain's 'confirmed'
    // unless adminApprovalCounts()) or void (never counts) a completed match not yet reviewed; the
    // captain's confirmation fields (by, at, reason, captain) are kept as they were.
    // 1.3.5 (QA E134-2): never the admin's own match: not its creator, scorer or a captain, and not in
    // participantIds (every player of both sides; src/core/antifraud.ts ownMatchReview).
    // 1.3.8 (V137-1): the verdict an admin review may write: the stored one, or (a 1.3.6 client answered
    // without `captain`) the one the older status records: confirmed -> 'confirmed', disputed -> 'rejected'.
    function verdictFromOld(old) {
      let st = old.get('status', 'pending');
      return old.get('captain', null) != null ? old.captain : (st == 'confirmed' ? 'confirmed' : (st == 'disputed' ? 'rejected' : null));
    }
    function reviewOk(r, v) {
      let old = r.get('verification', {});
      // 1.4.5 (QA V144-2): a match stored as finished without a Player of the Match (e.g. without a winner) can be voided
      return (completed(r) || (r.status == 'finished' && v.status == 'voided')) && !(vStatus(r) in ['approved', 'voided'])
        && uid() != r.createdBy && uid() != r.scorerId && !(uid() in r.participantIds)
        && !(uid() in [r.get('captains', {}).get('A', null), r.get('captains', {}).get('B', null)])
        && v.keys().hasOnly(['status', 'by', 'at', 'reason', 'reviewedBy', 'reviewedAt', 'captain', 'epoch'])
        && v.status in ['approved', 'voided'] && v.reviewedBy == uid() && v.reviewedAt == request.time
        && v.get('epoch', 0) == r.get('reopenEpoch', 0)
        && v.get('by', null) == old.get('by', null) && v.get('at', null) == old.get('at', null)
        && v.get('reason', null) == old.get('reason', null)
        // 1.3.9 (V138-3): when the captain answered (`by`), the approval/void MUST carry the verdict
        // (stored, or derived from the older status); an outdated admin client that drops it is refused.
        // Nobody answered: no verdict can be added.
        && (old.get('by', null) == null ? v.get('captain', null) == null : v.get('captain', null) == verdictFromOld(old));
    }
    function verificationWriteOk() {
      return changed().hasOnly(['verification', 'updatedAt'])
        && (isAdmin() ? reviewOk(resource.data, request.resource.data.verification)
          : confirmOk(resource.data, request.resource.data.verification));
    }
    // Captains (src/core/antifraud.ts captainsProblem): both set and different; a registered team's
    // captain is the team's captainId (same team doc as teamMembersOk: no extra read); a side built
    // by number names one of its own players.
    // (Kept to a few expressions: match create is close to the 1000-expression budget.)
    function captainsOk(d) {
      let c = d.captains;
      return c.keys().hasOnly(['A', 'B']) && c.A != c.B
        && sourceOk(d.teamA, d.participantIds, 0, c.A)
        && sourceOk(d.teamB, d.participantIds, d.teamA.players.size(), c.B);
    }

    // QA NB-R3/NB-R4: finishedAt changes only together with the status, and never into the future
    // (5 min allowance for device clocks). finishedServerAt is request.time of the write that
    // finished the match (kept while finished, null otherwise); Firebase rankings order by it.
    function finishTimesOk(d) {
      return (d.get('finishedAt', null) == null ? true : d.finishedAt <= nowMs() + 300000)
        && d.get('finishedServerAt', null) == (d.status == 'finished' ? request.time : null);
    }
    // Guards are written `ks.hasAny(..) ? check : true`: the rules engine evaluates both sides of
    // || (so `!changed || check` would always pay for the check); ?: runs only the chosen side.
    // 1.3.7: on update only the changed keys (ks, already bound) are checked against the key list: the
    // stored doc passed it on create, and this skips a d.keys() call (the 12-a-side finishing write is
    // at the 1000-expression budget).
    // The write that FINISHES a live match (status -> finished) has its own short list: at most the winning rally
    // (one appended event, or none: the rally was written before), the summary (shape only), the status and the
    // finish times – nothing else may ride on it. 1.4.4: the result is not checked here (rules can't replay);
    // a log too short for any win is refused as an obvious forgery (minWinEvents), and the app shows the replayed
    // result of whatever was finished – a premature finish shows no winner, never counts and is flagged.
    function finishingWriteOk(d, ks) {
      let o = resource.data.get('events', []);
      let n = d.get('events', []);
      return ks.hasOnly(['events', 'summary', 'status', 'finishedAt', 'finishedServerAt', 'updatedAt', 'serverUpdatedAt', 'maxEvents', 'wasWon'])
        && resource.data.status == 'live'
        && n.size() >= minWinEvents(d.rules)
        // 1.4.5 (V144-1): the wasWon latch is set by the write that finishes; no finish while a request is pending
        && d.get('wasWon', false) == true && resource.data.get('abandonRequest', null) == null
        && (ks.hasAny(['events', 'maxEvents']) ? maxEvOk(d) : true)
        && (ks.hasAny(['events']) ? n is list && n.size() == o.size() + 1 && n.size() <= 3000 && appendOk(o, n, o.size(), n.size(), d) : true)
        && (ks.hasAny(['summary']) ? summaryShapeOk(d.summary) : true)
        && finishTimesOk(d)
        && timesOk(d);
    }
    // Set lineups (src/core/rotation.ts): the scorer sets a set's starting six at the start of that set (score.tsx,
    // rot.atSetStart). Once the first rally exists, a set's lineup that is already stored never changes (it shaped
    // the rotation the credited rallies were scored with); a new set's lineup may be added. They don't affect the
    // result (the replay ignores them). Before the first rally anything goes.
    // 1.4.5 (PRD gap): one set's lineup per write (the app writes the set that starts), and its players are players of
    // the match (participantIds; empty slots are null). Before the first rally a lineup may still be changed or removed.
    function lineupsOk(d) {
      let o = resource.data.get('lineups', null);
      let l = d.get('lineups', null);
      let df = l == null ? null : (o == null ? l.diff({}) : l.diff(o));
      let set = df == null ? [] : df.addedKeys().union(df.changedKeys());
      return (l == null ? (o == null || resource.data.get('events', []).size() == 0)
        : l is map && set.size() <= 1
          && (set.size() == 0 ? true : setLineupOk(l, set, d.participantIds.concat([null])))
          && (resource.data.get('events', []).size() == 0 || o == null
            || (df.changedKeys().size() == 0 && df.removedKeys().size() == 0)));
    }
    // (rules Sets can't be indexed: the one written set is found among the set numbers 1–5)
    function setLineupOk(l, set, ids) {
      return set.hasOnly(['1', '2', '3', '4', '5'])
        && (set.hasAny(['1']) ? lineupInOk(l['1'], ids)
          : (set.hasAny(['2']) ? lineupInOk(l['2'], ids)
            : (set.hasAny(['3']) ? lineupInOk(l['3'], ids)
              : (set.hasAny(['4']) ? lineupInOk(l['4'], ids) : lineupInOk(l['5'], ids)))));
    }
    function lineupInOk(x, ids) {
      return x is map && x.keys().hasOnly(['A', 'B']) && x.get('A', []) is list && x.get('B', []) is list
        && x.get('A', []).size() <= 12 && x.get('B', []).size() <= 12
        && ids.hasAll(x.get('A', [])) && ids.hasAll(x.get('B', []));
    }
    function matchUpdateOk(d, ks) {
      return ks.hasAny(['status']) && d.status == 'finished' ? finishingWriteOk(d, ks) : matchUpdateOk2(d, ks);
    }
    function matchUpdateOk2(d, ks) {
      return matchKeysOk(ks, 'title')
        && (ks.hasAny(['playerOfMatchId']) ? potmOk(d, ks) : true)
        && (ks.hasAny(['events']) ? eventsOk(d) && resource.data.get('abandonRequest', null) == null : true)
        // 1.4.5 (V144-1): maxEvents only grows with the events; wasWon only latches (the finishing write sets it);
        // the abandon record only comes with the abandon (statusMoveOk → scorerAbandonOk)
        && (ks.hasAny(['events', 'maxEvents']) ? maxEvOk(d) : true)
        && (ks.hasAny(['wasWon']) ? d.wasWon == true : true)
        && (ks.hasAny(['abandon']) ? ks.hasAny(['status']) && d.status == 'abandoned' : true)
        && (ks.hasAny(['summary']) ? summaryShapeOk(d.get('summary', null)) : true)
        // V143-3: the replay's inputs are fixed once the first rally exists (and the write adding it can't change them).
        // 1.4.5 (V144-1/4): "exists" = ever existed (maxEv): undoing to 0 and raising bestOf would lift the shortest win
        // above maxEvents and re-open the scorer's abandon
        && (ks.hasAny(['rules', 'firstServe']) ? maxEv(resource.data) == 0 && d.get('events', []).size() == 0 : true)
        && (ks.hasAny(['lineups']) ? lineupsOk(d) : true)
        && (ks.hasAny(['interestedIds']) ? (d.interestedIds is list && d.interestedIds.size() <= 500) : true)
        && (ks.hasAny(['title', 'rules', 'status', 'firstServe', 'startedAt', 'startedServerAt', 'finishedAt', 'finishedServerAt', 'scheduledAt', 'location',
              'tournamentId', 'challengeId', 'fixtureId']) ? matchMetaOk(d, ks) : true);
    }

    match /matches/{matchId} {
      function isScorer() { return resource.data.scorerId == uid(); }
      function interestedToggle() {
        let before = resource.data.get('interestedIds', []).toSet();
        let after = request.resource.data.interestedIds.toSet();
        return changed().hasOnly(['interestedIds', 'updatedAt'])
          && after.difference(before).union(before.difference(after)).hasOnly([uid()]);
      }

      allow read: if signedIn();
      // 1.3.7: request.resource.data bound once (let), like updateAllowed(): this made room for
      // teamSizeMode on the 12-a-side create, which is at the 1000-expression budget.
      function createAllowed() {
        let d = request.resource.data;
        return d.createdBy == uid()
          && d.scorerId is string
          && uid() in d.participantIds
          && matchCreateOk(d)
          && validRoster(d)
          && captainsOk(d)
          // 1.4.8 (QA V147-1): someone can confirm the result, and the scorer isn't on that side
          && setupVerdictOk(d)
          && termsOk();
      }
      allow create: if signedIn() && createAllowed();
      // A legacy match left short of players (before minPlayers(), or players removed later) can't be
      // scored, but its scorer may still close it: only the status (to 'abandoned') and finish time change.
      function abandonOnly() {
        return request.resource.data.status == 'abandoned' && resource.data.status in ['scheduled', 'live']
          && changed().hasOnly(['status', 'finishedAt', 'updatedAt', 'abandon']);
      }
      // The branches are chosen with ?: (both sides of || are always evaluated, and the scorer's
      // finishing write on a big match is close to the 1000-expression budget).
      function scorerWriteOk(ks, d) {
        // (createdBy can't change: see matchKeysOk)
        return (ks.hasAny(['teamA', 'teamB', 'participantIds', 'captains', 'teamSizeMode'])
                // 1.4.6 (QA V145-3): the set-up is frozen once a rally EVER existed (maxEvents; undo to 0 doesn't reopen it)
                // 1.4.8 (QA V147-1): and the roster edit keeps the verdict invariant (setupVerdictOk)
                ? (maxEv(resource.data) == 0 && d.get('events', []).size() == 0 && validRoster(d) && captainsOk(d) && teamSizeOk(d) && setupVerdictUpdOk(d))
                : (enoughPlayers(d) ? true : abandonOnly()));
      }
      // 1.4.5 (QA V144-1/2/3): an admin who isn't part of the match resolves it (first: before the finished branch – a
      // finished match without a winner can be re-opened / abandoned – and, 1.4.6 (QA V145-2), before the verification
      // branch – a re-open removes the verdict / review).
      // ks / d are bound once (let) and passed down: a function argument is re-evaluated at every
      // reference, and changed() is a full document diff (1.3.0: this freed the expression budget).
      function updateAllowed() {
        let ks = changed();
        let d = request.resource.data;
        return ks.hasAny(['verdictRepair']) ? verdictRepairOk(d, ks) && termsOk()
          : (isAdmin() && ks.hasAny(['status', 'abandon', 'abandonRequest', 'resolution', 'scorerId']) && !ownMatch(resource.data)) ? adminResolveOk(d, ks) && termsOk()
          : ks.hasAny(['verification']) ? verificationWriteOk() && termsOk()
          // 1.4.3 (QA V142-2): a finished match (with or without the Player of the Match) is final
          : resource.data.status == 'finished' ? finishedWriteOk(d, ks)
          // 1.4.5 ('consent' policy): the abandon request and its answers
          : ks.hasAny(['abandonRequest']) ? abandonRequestOk(d, ks) && termsOk()
          // 1.4.5: the opposing captain's report of an abandoned match
          : (resource.data.status == 'abandoned' && ks.hasAny(['abandon'])) ? reportOk(d, ks) && termsOk()
          : matchUpdateOk(d, ks) && (
            // An abandoned match is closed: only "I want to play" still changes.
            resource.data.status == 'abandoned' ? interestedToggle()
            // The assigned scorer controls the score (but can't silently change who the scorer is here).
            // Players can only change before the first rally; scoring needs minPlayers() per team.
            : (isScorer() && d.scorerId == resource.data.scorerId)
              ? (scorerWriteOk(ks, d) ? true : interestedToggle() && termsOk())
              // The creator or the current scorer can hand scoring to someone else (that field only),
              // while the match isn't over (QA PM-13).
              : ((((resource.data.createdBy == uid() || isScorer()) && ks.hasOnly(['scorerId', 'updatedAt'])
                  && resource.data.status in ['scheduled', 'live'] && handoverOk(resource.data, d.scorerId) && scorerTargetOk(d))
                // Anyone can add/remove themselves from "I want to play".
                || interestedToggle()) && termsOk()));
      }
      // termsOk() (1 read) is required for every match write except the assigned scorer's own
      // scoring writes: QA TC-13 allows an in-progress score to be saved after a T&C version bump
      // (no data loss), and the finishing write of a big match is at the 1000-expression budget.
      // Everyone who can be a scorer is a registered user, and a profile needs an accepted T&C.
      allow update: if signedIn() && updateAllowed();
      // 1.4.6 (QA V145-1, core/lifecycle.ts 'delete'): only a scheduled / abandoned match that NEVER had a rally (maxEvents
      // == 0 – undo to 0 doesn't count) and has no abandon record, request or admin re-open; by its creator or an admin
      // who isn't part of it. A finished or live match is never deleted (1.3.0 let an admin delete a finished one).
      function deleteOk(r) {
        return r.status in ['scheduled', 'abandoned'] && maxEv(r) == 0
          && r.get('abandon', null) == null && r.get('abandonRequest', null) == null && r.get('resolution', null) == null
          && r.get('reopenEpoch', 0) == 0
          && ((isAdmin() && !ownMatch(r)) ? true : (r.createdBy == uid() && termsOk()));
      }
      allow delete: if signedIn() && deleteOk(resource.data);

      match /photos/{photoId} {
        // Players of team A or B and the scorer (src/core/photos.ts canAddMatchPhoto); not the
        // creator alone, not followers. participantIds[0:n] are exactly the players (participantsOk).
        function canAddPhoto(m) {
          return uid() == m.scorerId || uid() in m.participantIds[0:m.teamA.players.size() + m.teamB.players.size()];
        }
        allow read: if signedIn();
        // QA G3: the URL must be this project's Storage download URL for this match + uploader.
        // 1.3.5 (QA Firebase residuals D133-2/D133-3), enforced here, not only in the app:
        //  - one photo per file per match: the document id IS the file's sha256 (`hash`), so a second
        //    copy is a create on an existing id, which this rule never allows (no update rule);
        //  - at most MAX_PHOTOS_PER_MATCH (50, src/core/limits.ts) per match: every create must, in the
        //    same batch/transaction, move the match's counter photoMeta/count from n to n + 1 (<= 50)
        //    and name this photo in it (`last`); a delete moves it back (n - 1). The counter's own rule
        //    accepts a change only together with that photo's create/delete, so it always equals the
        //    number of these photos. Concurrent creates race on the counter: only one gets n + 1.
        // Limits: rules can't hash the uploaded bytes, so the hash is what the app computed (a forged
        // client can claim another hash for the same bytes: the API server, which hashes the file
        // itself, has no such gap). Photos stored before 1.3.5 (random ids) are not in the counter.
        function photoCounter() { return /databases/$(database)/documents/matches/$(matchId)/photoMeta/count; }
        function counterN() { return exists(photoCounter()) ? get(photoCounter()).data.n : 0; }
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['matchId', 'url', 'storagePath', 'uploadedBy', 'createdAt', 'hash', 'key'])
          && request.resource.data.uploadedBy == uid()
          && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{64}$')
          && photoId == request.resource.data.hash
          && (request.resource.data.get('key', null) == null || (request.resource.data.key is string && request.resource.data.key.matches('^[A-Za-z0-9_-]{8,64}$')))
          && getAfter(photoCounter()).data.last == photoId
          && getAfter(photoCounter()).data.n == counterN() + 1
          && getAfter(photoCounter()).data.n <= 50
          && request.resource.data.get('matchId', matchId) == matchId
          && photoUrlOk(request.resource.data.url, 'matches%2F' + matchId + '%2F' + uid() + '%2F')
          && (request.resource.data.get('storagePath', null) == null
              || request.resource.data.storagePath.matches('^matches/' + matchId + '/' + uid() + '/[A-Za-z0-9._-]+$'))
          && optMsOk(request.resource.data.get('createdAt', null))
          && canAddPhoto(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && termsOk();
        // Uploader only. A counted photo (id = hash) gives its slot back in the same batch; a photo
        // from before 1.3.5 (random id) is simply deleted.
        allow delete: if signedIn() && resource.data.uploadedBy == uid()
          && (photoId != resource.data.get('hash', null)
              || (getAfter(photoCounter()).data.n == counterN() - 1 && getAfter(photoCounter()).data.last == photoId));
      }

      // 1.3.5: the per-match photo counter (see photos above). Readable by any signed-in user; it
      // changes only by exactly one, together with the create/delete of the photo it names.
      match /photoMeta/{metaId} {
        function photoAt(id) { return /databases/$(database)/documents/matches/$(matchId)/photos/$(id); }
        function counterKeysOk() {
          return metaId == 'count' && request.resource.data.keys().hasOnly(['n', 'last'])
            && request.resource.data.n is int && request.resource.data.last is string
            && request.resource.data.last.matches('^[0-9a-f]{64}$');
        }
        function addsPhoto() {
          let id = request.resource.data.last;
          return !exists(photoAt(id)) && existsAfter(photoAt(id)) && getAfter(photoAt(id)).data.uploadedBy == uid();
        }
        function removesPhoto() {
          let id = request.resource.data.last;
          return exists(photoAt(id)) && !existsAfter(photoAt(id)) && get(photoAt(id)).data.uploadedBy == uid();
        }
        allow read: if signedIn();
        allow create: if signedIn() && counterKeysOk() && request.resource.data.n == 1 && addsPhoto();
        allow update: if signedIn() && counterKeysOk()
          && ((request.resource.data.n == resource.data.n + 1 && request.resource.data.n <= 50 && addsPhoto())
              || (request.resource.data.n == resource.data.n - 1 && request.resource.data.n >= 0 && removesPhoto()));
      }
    }

    // ---------- challenges ----------
    match /challenges/{challengeId} {
      allow read: if signedIn();
      function fromTeam() { return get(/databases/$(database)/documents/teams/$(request.resource.data.fromTeamId)).data; }
      function toTeam() { return get(/databases/$(database)/documents/teams/$(request.resource.data.toTeamId)).data; }
      function challengeOk(d, ks) {
        return d.keys().hasOnly(['fromTeamId', 'fromTeamName', 'fromCaptainId', 'toTeamId', 'toTeamName', 'toCaptainId',
              'when', 'location', 'message', 'rules', 'status', 'matchId', 'createdAt'])
          && idOk(d.fromTeamId) && idOk(d.toTeamId) && d.fromTeamId != d.toTeamId
          && notPast(d.when)
          && placeOk(d.location)
          && rulesOk(d.rules)
          && (d.get('message', null) == null || (d.message is string && d.message.size() <= 500 && d.message == d.message.trim() && noBadChars(d.message)))
          && d.get('matchId', null) == null
          && optMsOk(d.get('createdAt', null))
          // QA G19: team names are copied from the team documents, not typed by the sender.
          && d.fromTeamName == fromTeam().name && d.toTeamName == toTeam().name;
      }
      // Reads: 2 team documents (fromTeam/toTeam/teamCanPlay share them), well inside the 10 limit.
      allow create: if signedIn() && termsOk()
        && request.resource.data.fromCaptainId == uid()
        && request.resource.data.status == 'pending'
        && challengeOk(request.resource.data, writtenKeys())
        && fromTeam().captainId == uid()
        && toTeam().captainId == request.resource.data.toCaptainId
        && teamCanPlay(request.resource.data.fromTeamId) && teamCanPlay(request.resource.data.toTeamId);
      allow update: if signedIn() && termsOk() && (
        (resource.data.toCaptainId == uid() && resource.data.status == 'pending'
          && changed().hasOnly(['status', 'matchId'])
          && request.resource.data.status in ['accepted', 'declined']
          && (request.resource.data.status == 'declined'
              || (teamCanPlay(resource.data.fromTeamId) && teamCanPlay(resource.data.toTeamId))))
        || (resource.data.fromCaptainId == uid() && resource.data.status == 'pending'
          && changed().hasOnly(['status']) && request.resource.data.status == 'cancelled')
      );
      allow delete: if false;
    }

    // ---------- tournaments ----------
    // Tournament teams must be registered teams with minPlayers() members. Rules have no loops and
    // may read 10 documents per request, so a tournament has at most 10 teams (src/core/limits.ts
    // MAX_TOURNAMENT_TEAMS, same cap in the app and the API, QA G8 retest 217) and EVERY team is
    // checked here (1 read each) on create and whenever teams[] changes. Every fixture match is
    // then created through the matches rules above, which check the team exists and that every
    // player is one of its members.
    function tTeamOk(t) {
      return t is map && idOk(t.id)
        && get(/databases/$(database)/documents/teams/$(t.id)).data.memberIds.size() >= minPlayers();
    }
    function tournamentTeamsOk(ts) {
      return ts is list && ts.size() >= 2 && ts.size() <= 10
        && tTeamOk(ts[0]) && tTeamOk(ts[1])
        && (ts.size() <= 2 || tTeamOk(ts[2]))
        && (ts.size() <= 3 || tTeamOk(ts[3]))
        && (ts.size() <= 4 || tTeamOk(ts[4]))
        && (ts.size() <= 5 || tTeamOk(ts[5]))
        && (ts.size() <= 6 || tTeamOk(ts[6]))
        && (ts.size() <= 7 || tTeamOk(ts[7]))
        && (ts.size() <= 8 || tTeamOk(ts[8]))
        && (ts.size() <= 9 || tTeamOk(ts[9]));
    }
    // QA G8: 2 to 10 teams, no team twice (all ids compared), end on or after start, a new start
    // date not in the past.
    function tournamentTeamIdsUnique(ts) {
      let ids = playerIds(ts);
      return ts.size() <= 10 && ids.toSet().size() == ids.size();
    }
    function tournamentOk(d, ks) {
      return d.keys().hasOnly(['name', 'organizerId', 'format', 'rules', 'startDate', 'endDate', 'location', 'teams',
            'fixtures', 'status', 'createdAt', 'updatedAt'])
        && (!ks.hasAny(['name']) || nameOk(d.name, 3, 80))
        && (!ks.hasAny(['format']) || d.format in ['knockout', 'league'])
        && (!ks.hasAny(['status']) || d.status in ['registration', 'running', 'finished'])
        && (!ks.hasAny(['rules']) || rulesOk(d.rules))
        && (!ks.hasAny(['location']) || placeOk(d.location))
        && (!ks.hasAny(['startDate']) || notPast(d.startDate))
        && (!ks.hasAny(['startDate', 'endDate']) || (msOk(d.startDate) && msOk(d.endDate) && d.endDate >= d.startDate))
        && (!ks.hasAny(['teams']) || (d.teams is list && tournamentTeamIdsUnique(d.teams)))
        && (!ks.hasAny(['fixtures']) || (d.fixtures is list && d.fixtures.size() <= 2000))
        && (!ks.hasAny(['createdAt']) || optMsOk(d.get('createdAt', null)));
    }
    // T&C (1.3.0): a request may read at most 10 documents. A tournament write reads each team
    // (max 10), so the terms check is skipped when that would be the 11th read. The API server
    // always enforces T&C; a 10-team tournament's fixture matches are still gated by match create.
    function tournamentTermsOk(teamsRead) {
      return teamsRead && request.resource.data.get('teams', []).size() >= 10 ? true : termsOk();
    }
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create: if signedIn() && tournamentTermsOk(true) && request.resource.data.organizerId == uid()
        && tournamentOk(request.resource.data, writtenKeys())
        && tournamentTeamsOk(request.resource.data.teams);
      allow update: if signedIn() && tournamentTermsOk(changed().hasAny(['teams'])) && resource.data.organizerId == uid()
        && request.resource.data.organizerId == uid()
        && tournamentOk(request.resource.data, writtenKeys())
        && (!changed().hasAny(['teams']) || tournamentTeamsOk(request.resource.data.teams));
      allow delete: if signedIn() && resource.data.organizerId == uid();
    }

    // ---------- courts ----------
    match /courts/{courtId} {
      allow read: if signedIn();
      function courtOk(d, ks) {
        return d.keys().hasOnly(['name', 'location', 'surface', 'addedBy', 'createdAt'])
          && (!ks.hasAny(['name']) || nameOk(d.name, 2, 80))
          && (!ks.hasAny(['location']) || placeOk(d.location))
          && (!ks.hasAny(['surface']) || d.surface in ['indoor', 'beach', 'grass', 'outdoor'])
          && (!ks.hasAny(['createdAt']) || optMsOk(d.get('createdAt', null)));
      }
      allow create: if signedIn() && termsOk() && request.resource.data.addedBy == uid() && courtOk(request.resource.data, writtenKeys());
      allow update: if signedIn() && termsOk() && resource.data.addedBy == uid()
        && request.resource.data.addedBy == uid() && courtOk(request.resource.data, writtenKeys());
      allow delete: if signedIn() && resource.data.addedBy == uid();
    }

    // 1.3.7 Profile > Send feedback: a signed-in user creates their own (1–5 stars, text <= 1000, no
    // control characters); only admins read it; nobody edits or deletes it. Never rewarded.
    match /feedback/{feedbackId} {
      allow read: if signedIn() && isAdmin();
      // 1.3.8 (V137-5): needs the current T&C (like the API); hidden characters (control, zero-width,
      // bidi controls, BOM) are refused – the app strips them first (core/reviewPrompt.ts checkFeedback);
      // newlines and tabs are allowed, as on the API.
      allow create: if signedIn() && termsOk()
        && request.resource.data.keys().hasOnly(['userId', 'stars', 'text', 'appVersion', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'stars', 'text', 'createdAt'])
        && request.resource.data.userId == uid()
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && !request.resource.data.text.matches('(?s).*[\\x{0}-\\x{8}\\x{B}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}].*')
        && (request.resource.data.get('appVersion', null) == null || !request.resource.data.appVersion.matches('(?s).*[\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}].*'))
        && (request.resource.data.get('appVersion', null) == null || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 1.3.7 "Fact of the day": public read (the app filters inactive items); admins add / edit / delete
    // (1.4.1: delete = a tombstone update, see removalOk).
    // Quotes need an attribution and an https source URL (src/core/dailyItems.ts checkDailyItem).
    match /dailyItems/{itemId} {
      allow read: if true;
      // 1.3.8 (V137-5): no control / zero-width / bidi characters (core/dailyItems.ts CTRL)
      function cleanText(x) {
        return !x.matches('(?s).*[\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}].*');
      }
      function dailyOk(d) {
        return d.keys().hasOnly(['type', 'textEn', 'textHi', 'attribution', 'sourceUrl', 'active', 'updatedAt', 'createdAt', 'removedAt', 'deleted'])
          && d.get('deleted', false) is bool
          && d.keys().hasAll(['type', 'textEn', 'textHi', 'active'])
          && d.type in ['fact', 'quote'] && d.active is bool
          // 1.4.2 (QA V141-6): a deleted item (tombstone) keeps no text – it was publicly readable
          && (d.get('deleted', false) == true ? tombstoneOk(d) : dailyTextOk(d));
      }
      function tombstoneOk(d) {
        return d.textEn == '' && d.textHi == '' && d.get('attribution', null) == null && d.get('sourceUrl', null) == null;
      }
      function dailyTextOk(d) {
        return d.textEn is string && d.textEn.size() > 0 && d.textEn.size() <= 400 && cleanText(d.textEn)
          && d.textHi is string && d.textHi.size() > 0 && d.textHi.size() <= 400 && cleanText(d.textHi)
          && (d.get('attribution', null) == null || (d.attribution is string && d.attribution.size() <= 120 && cleanText(d.attribution)))
          && (d.get('sourceUrl', null) == null || (d.sourceUrl is string && d.sourceUrl.size() <= 500 && d.sourceUrl.matches('https://[^\\s]+') && cleanText(d.sourceUrl)))
          && (d.type == 'fact' || (d.get('attribution', null) is string && d.get('sourceUrl', null) is string));
      }
      // 1.3.9 (V138-7): createdAt = server time on create, unchanged afterwards (a new fact joins the daily
      // rotation the next IST day: core/dailyItems.ts pickDaily). Absent (pre-1.3.9 admin app / docs): the item
      // is simply always in the rotation. It can never be back- or forward-dated.
      // 1.4.1 (QA V140-7): removedAt = server time when an item is turned off (or created off), set once and
      // never changed; an item that is off can't be turned back on (the app makes a copy: a new item) and a
      // deleted one (deleted = true, a tombstone) can't change at all; docs are never deleted. Started rotation
      // cycles keep the item's slot (core/dailyItems.ts pickDaily), so nothing an admin does reshapes them.
      // A doc turned off before 1.4.1 (no removedAt) keeps none: it is in no cycle, and stamping it later would
      // make it a member of the running cycle and shift today's fact.
      function removalOk(d, old) {
        let rm = d.get('removedAt', null);
        return (d.get('deleted', false) == false || d.active == false)
          && (old == null ? (d.get('deleted', false) == false && (d.active ? rm == null : rm == request.time))
            : (old.get('deleted', false) == false
              ? (old.active != false ? (d.active ? rm == null : rm == request.time)
                : (d.active == false && rm == old.get('removedAt', null)))
              // 1.4.2 (V141-6): a 1.4.1 tombstone that still has its text may only be scrubbed (stays deleted)
              : (old.get('textEn', '') != '' && d.get('deleted', false) == true && d.active == false
                && rm == old.get('removedAt', null) && d.type == old.type)));
      }
      allow create: if signedIn() && isAdmin() && dailyOk(request.resource.data) && removalOk(request.resource.data, null)
        // 1.4.2 (QA V141-3): createdAt is required on create and is the server's time (no back-/forward-dating;
        // absent = always in the rotation was a way to jump the queue)
        && request.resource.data.get('createdAt', null) == request.time;
      allow update: if signedIn() && isAdmin() && dailyOk(request.resource.data) && removalOk(request.resource.data, resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if false;
    }
  }
}
