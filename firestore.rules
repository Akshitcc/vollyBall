        && (string(m.get('setsA', 0)) + '|' + string(m.get('setsB', 0)) + '|' + string(m.get('currentA', 0)) + '|' + string(m.get('currentB', 0))
            + '|' + string(m.get('serving', 'A')) + '|' + string(m.get('winner', null)))
