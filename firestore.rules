      return r.status == 'live' && (o == null
        ? abandonPolicy() == 'consent' && r.scorerId == uid() && ks.hasOnly(['abandonRequest', 'abandonRequests', 'abandonRequestAt', 'updatedAt'])
          && r.get('wasWon', false) != true && maxEv(r) > 0 && maxEv(r) < minWinEvents(r.rules) && r.get('abandon', null) == null
          && d.abandonRequests == r.get('abandonRequests', 0) + 1 && d.abandonRequests <= 3 && d.abandonRequestAt == request.time
          && (r.get('abandonRequestAt', null) == null || request.time >= r.abandonRequestAt + duration.value(120, 's'))
          && n.keys().hasOnly(['by', 'at', 'side', 'agreedBy']) && n.by == uid() && n.at == request.time && n.agreedBy == []
