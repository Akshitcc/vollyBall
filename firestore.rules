rules_version = '2';

// VolleyLive Firestore security rules (Firebase-direct mode).
// With the API server (server/), the same rules are enforced in server/src/domain; see server/RULES.md.
// Key guarantees:
//  * Only the assigned scorer can change a match's score (events/summary/status).
//  * Only a team's captain can edit the team and can only invite REGISTERED numbers;
//    players can only accept/decline
//    their own invite (verified by the phone number on their auth token) or leave.
//  * Users can only claim their own verified phone number.
//  * Match players are registered users (by id), 12 max per team, 6 before scoring starts,
//    and they can't change after the first rally (see "match rosters").
//  * 1.3.0: every write needs the current T&C accepted (terms/{uid}, written only by the accept
//    action with request.time); results are confirmed by the opposing captain or reviewed by an
//    admin (custom claim `admin`, set by the operator with the Admin SDK: nothing in the app creates
//    it); completed/abandoned matches are terminal; start/finish times are the server's.
//    Points, the win bonus and the wallet are DERIVED (src/core/antifraud.ts): no collection stores
//    them and there is no catch-all rule, so wallets/ledger/redemptions/payouts writes are denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myPhone() { return request.auth.token.phone_number; }
    // Indian mobile numbers only, E.164: same pattern as src/core/phone.ts (E164_IN_RE) and the API.
    function validPhone(p) { return p is string && p.matches('^[+]91[6-9][0-9]{9}$'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // ---------- T&C (1.3.0) ----------
    // Must equal src/core/terms.ts TERMS_VERSION (rules-tests compare them).
    function termsVersion() { return '2026-10-draft-1'; }
    // The caller accepted the CURRENT version (a missing doc fails the get = denied). 1 read.
    function termsOk() { return get(/databases/$(database)/documents/terms/$(uid())).data.version == termsVersion(); }
    // Admin = custom claim set by the operator (Admin SDK) for ADMIN_UIDS; the app never sets claims.
    function isAdmin() { return request.auth.token.get('admin', false) == true; }

    // ---------- shared input checks (QA G1/G3/G7/G14/G15) ----------
    // Text limits are the same table as src/core/limits.ts (LIMITS); rules-tests compare the numbers.
    // Text must already be cleaned by the client (src/core/text.ts cleanText): trimmed, no zero-width
    // characters, no control characters, no bidi overrides/isolates/marks. Names need a letter or digit.
    // Checked on write only (create, or update of that field): stored documents are never rewritten.
    // One regex each (cheap in the rules' 1000-expression budget). Allowed characters exclude
    // control (C0/C1, incl. tab/newline), soft hyphen, zero-width, bidi marks/overrides/isolates, BOM.
    // 1.3.9 (V138-4): ONE hidden-character set, written out in each regex below (no string building:
    // match writes are close to the expression budget) and equal to src/core/text.ts HIDDEN_CHARS –
    // rules-tests parse every copy and compare: C0/C1, U+00AD, U+061C, U+180E, U+200B-200F, U+2028/2029,
    // U+202A-202E, U+2060-2064, U+2066-2069, U+FEFF. Variants: multi-line text (feedback, challenge
    // message) allows newline/tab. Names (nameRe): ZWNJ/ZWJ (U+200C/200D, in the set) appear only inside
    // a "joined chain" D(JD)+ of Devanagari characters D, so a joiner is always directly between two
    // Devanagari characters (src/core/text.ts removeInvisible keeps exactly these) - in the regex
    // itself, at no extra expression cost. The chain also counts as the required letter when it holds
    // a Devanagari letter or digit.
    // textRe: empty, or starts and ends with a character JavaScript's trim() keeps: not ASCII space,
    // no-break space, U+1680, U+2000-200A, line/paragraph separator, U+202F, U+205F, U+3000, and
    // not an invisible filler (Hangul U+115F/1160/3164/FFA0, braille blank U+2800), the same set
    // src/core/text.ts cleanText trims (QA retest 217 #4, #7). U+180E is refused anywhere (the app
    // removes it). nameRe: same, plus a letter or digit somewhere that is not a filler.
    // Lengths: size() counts UTF-16 units and so does the app (text.ts textLength, retest 217 #6).
    function textRe() { return '^([^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]([^\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]*[^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}])?)?$'; }
    function nameRe() { return '^((?:(?:[^\\P{L}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}]|\\p{N})|(?:[\\x{900}-\\x{97F}][\\x{200C}\\x{200D}])*(?:[^\\P{L}\\x{0}-\\x{8FF}\\x{980}-\\x{10FFFF}]|[\\x{966}-\\x{96F}])(?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])*)|(?:(?:[^\\P{L}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}]|\\p{N})|(?:[\\x{900}-\\x{97F}][\\x{200C}\\x{200D}])*(?:[^\\P{L}\\x{0}-\\x{8FF}\\x{980}-\\x{10FFFF}]|[\\x{966}-\\x{96F}])(?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])*)(?:[^\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)*(?:[^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)|(?:[^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)(?:[^\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)*(?:(?:[^\\P{L}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}]|\\p{N})|(?:[\\x{900}-\\x{97F}][\\x{200C}\\x{200D}])*(?:[^\\P{L}\\x{0}-\\x{8FF}\\x{980}-\\x{10FFFF}]|[\\x{966}-\\x{96F}])(?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])*)|(?:[^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)(?:[^\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)*(?:(?:[^\\P{L}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}]|\\p{N})|(?:[\\x{900}-\\x{97F}][\\x{200C}\\x{200D}])*(?:[^\\P{L}\\x{0}-\\x{8FF}\\x{980}-\\x{10FFFF}]|[\\x{966}-\\x{96F}])(?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])*)(?:[^\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+)*(?:[^\\s\\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{115F}\\x{1160}\\x{3164}\\x{FFA0}\\x{2800}\\x{0}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]|[\\x{900}-\\x{97F}](?:[\\x{200C}\\x{200D}][\\x{900}-\\x{97F}])+))$'; }
    function textOk(s, max) { return s is string && s.size() <= max && s.matches(textRe()); }
    function optTextOk(s, max) { return s == null || textOk(s, max); }
    function nameOk(s, min, max) { return s is string && s.size() >= min && s.size() <= max && s.matches(nameRe()); }
    function noBadChars(s) { return s.matches('[^\\x{0}-\\x{8}\\x{B}-\\x{1F}\\x{7F}-\\x{9F}\\x{AD}\\x{61C}\\x{180E}\\x{200B}-\\x{200F}\\x{2028}\\x{2029}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{2066}-\\x{2069}\\x{FEFF}]*'); }  // multi-line text: newline/tab allowed
    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function optIntIn(v, lo, hi) { return v == null || intIn(v, lo, hi); }
    function msOk(v) { return v is int && v >= 0; }
    function optMsOk(v) { return v == null || msOk(v); }
    function nowMs() { return request.time.toMillis(); }
    // Start times may be up to 15 minutes in the past (src/core/dates.ts PAST_GRACE_MS).
    function notPast(v) { return msOk(v) && v >= nowMs() - 900000; }
    // Keys being written: every key on create, the changed ones on update.
    function writtenKeys() { return resource == null ? request.resource.data.keys() : changed(); }
    function placeOk(p) {
      // A missing key or a non-number makes a comparison fail to evaluate, which denies the write.
      return p.keys().hasOnly(['name', 'lat', 'lng'])
        && p.name.size() <= 160 && p.name.matches(nameRe())
        && p.lat >= -90 && p.lat <= 90 && p.lng >= -180 && p.lng <= 180;
    }
    // #RRGGBB only: the same pattern as the app and the API (src/core/limits.ts HEX_COLOR_RE).
    function colorOk(c) { return c is string && c.matches('^#[0-9A-Fa-f]{6}$'); }
    // Rule set: same ranges as the API (server/src/domain/schemas.ts ruleSetSchema) and the
    // cross-field checks of src/core/rules.ts validateRules.
    function rulesOk(r) {
      // All 10 fields present (size 10, each read below) and nothing else; integer fields in range via
      // one regex over their decimal form (a float like 1.5 or a negative number fails it), and the
      // sum fails to evaluate (deny) if any required field is a string.
      return r.size() == 10 && r.preset in ['indoor', 'beach', 'custom']
        && (string(r.bestOf) + ',' + string(r.pointsPerSet) + ',' + string(r.decidingSetPoints) + ',' + string(r.winBy)
            + ',' + string(r.timeoutsPerSet) + ',' + string(r.pointCap) + ',' + string(r.sideSwitchEvery)
            + ',' + string(r.decidingSideSwitchEvery) + ',' + string(r.decidingSwitchAt))
            .matches('^[135],[1-9][0-9]?,[1-9][0-9]?,[1-5],[0-9](,(null|[1-9][0-9]?)){4}$')
        && r.bestOf + r.pointsPerSet + r.decidingSetPoints + r.winBy + r.timeoutsPerSet > 0
        && (r.pointCap == null || r.pointCap >= r.pointsPerSet)
        && (r.decidingSwitchAt == null || r.decidingSwitchAt <= r.decidingSetPoints);
    }
    // Photo URLs (QA G3): https on this project's Firebase Storage bucket, under the expected path.
    // request.auth.token.aud is the project id; demo-* projects (emulator only) may use the emulator host.
    function bucketRe() {
      return request.auth.token.aud + '[.](appspot[.]com|firebasestorage[.]app)';
    }
    function photoUrlOk(url, encodedPrefix) {
      let path = '/v0/b/' + bucketRe() + '/o/' + encodedPrefix + '[A-Za-z0-9._-]+([?][^\\s]*)?$';
      return url is string && url.size() <= 2048
        && (url.matches('^https://firebasestorage[.]googleapis[.]com' + path)
          || (request.auth.token.aud.matches('^demo-.*')
              && url.matches('^http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2):9199' + path)));
    }

    // ---------- match rosters ----------
    // Every player is a registered user referenced by id (no typed names or guests), at most
    // maxPlayers() per team, nobody twice, nobody on both teams, and minPlayers() per team before
    // scoring starts. minPlayers() must equal MIN_PLAYERS in src/core/roster.ts (rules-tests check it).
    // Rules can't loop, so participantIds has one fixed order (core/roster.ts canonicalParticipants):
    // team A's player ids, team B's player ids, then the creator/scorer if not already listed.
    // Every backend (firebaseBackend, demo, API server) normalises to this order before writing, so
    // the rules stay exact: any other order is rejected rather than checked with 24 unrolled `in`s.
    // playersOk() compares each team's player ids with its part of participantIds.
    // Limit: rules may read at most 10 documents per request. A registered team side (teamId
    // set) is checked against that team's memberIds (only people who accepted an invite: 1 read).
    // A side built by mobile number (teamId null) has every id format-checked, and its first
    // byNumberChecked() players must have a users/{id} profile (1 read each; 2 teams + 2 x 4 = at
    // most 10). Remaining gap: players 5-12 of a by-number side are format-checked only here; the
    // app (firebaseBackend.assertPlayersRegistered) checks them all before writing, and the API
    // server (server/src/domain/matches.ts) checks every player against the users table.
    function minPlayers() { return 6; }
    function maxPlayers() { return 12; }
    function idOk(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function sideOk(t) {
      // (1.4.4: no `is list` – a non-list fails rosterIdsOk's p[i].id, which denies the write)
      return t.players.size() <= maxPlayers()
        && t.name.size() <= 40 && t.name.matches(nameRe())
        && t.color.matches('^#[0-9A-Fa-f]{6}$')
        && (t.get('teamId', null) == null || idOk(t.teamId));
    }
    // Player ids of a team (sizes above maxPlayers() are rejected before this runs). Unrolled
    // by size (a binary split keeps it cheap) because rules have no loops and stop after
    // 1000 evaluated expressions.
    function playerIds(p) {
      let n = p.size();
      return (n <= 6
        ? (n <= 3
          ? (n <= 1
            ? (n <= 0
              ? []
              : [p[0].id])
            : (n <= 2
              ? [p[0].id, p[1].id]
              : [p[0].id, p[1].id, p[2].id]))
          : (n <= 5
            ? (n <= 4
              ? [p[0].id, p[1].id, p[2].id, p[3].id]
              : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id])
            : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id]))
        : (n <= 9
          ? (n <= 8
            ? (n <= 7
              ? [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id]
              : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id, p[7].id])
            : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id, p[7].id, p[8].id])
          : (n <= 11
            ? (n <= 10
              ? [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id, p[7].id, p[8].id, p[9].id]
              : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id, p[7].id, p[8].id, p[9].id, p[10].id])
            : [p[0].id, p[1].id, p[2].id, p[3].id, p[4].id, p[5].id, p[6].id, p[7].id, p[8].id, p[9].id, p[10].id, p[11].id])));
    }
    // Every id in a list has the user-id format (no typed names): one regex over the joined list,
    // and the split count proves no element smuggled a '|' in. Cheaper than unrolling per player,
    // which leaves room in the 1000-expression budget for the field checks (QA G1).
    function listIdsOk(ids) {
      let j = ids.join('|');
      return ids.size() == 0
        || (j.matches('^[A-Za-z0-9_-]{1,128}([|][A-Za-z0-9_-]{1,128})*$') && j.split('[|]').size() == ids.size());
    }
    // participantIds[off .. off+n) must be exactly this team's player ids, in order.
    // participantIds is format-checked as a whole (listIdsOk), so equal ids are well-formed too.
    function playersOk(p, ids, off) {
      let n = p.size();
      return n == 0 || ids[off:off + n] == playerIds(p);
    }
    function participantsOk(d) {
      let n = d.teamA.players.size() + d.teamB.players.size();
      let ids = d.participantIds;
      return ids.size() >= n && ids.size() <= n + 2
        && ids.toSet().size() == ids.size() && listIdsOk(ids)
        && (ids.size() == n || ids[n:ids.size()].toSet().hasOnly([d.createdBy, d.scorerId]));
    }
    // 1.4.4 (QA V143-5): each side's source is checked once, together with its captain (captainsOk), so the teamId
    // is read once per side and a registered team's doc once: the team's memberIds hold every player of the side
    // and its captainId is the side's captain; a side built by number names one of its own players as captain and
    // its first 4 players must have a profile (byNumberUsersOk; see the read budget above).
    function sourceOk(t, ids, off, cap) {
      let s = ids[off:off + t.players.size()];
      return t.get('teamId', null) == null
        // 1.4.5 (PRD gap): the captain has a profile too – byNumberUsersOk checks the first 3 players, so a captain
        // outside them costs one more exists() (a by-number create stays within the 10 document reads:
        // 2 x (3 + 1) + terms). s[0:3] is the side's first 3 players (or all of a smaller side).
        ? (cap in s[0:3] ? byNumberUsersOk(t.players)
          : cap in s && byNumberUsersOk(t.players) && exists(/databases/$(database)/documents/users/$(cap)))
        : teamDocOk(get(/databases/$(database)/documents/teams/$(t.teamId)).data, ids, off, t.players.size(), cap);
    }
    function teamDocOk(td, ids, off, n, cap) {
      return td.captainId == cap && (n == 0 || td.memberIds.hasAll(ids[off:off + n]));
    }
    // 1.4.4 (QA V143-5): the first 3 players (was 4) of a side built by number must have a profile – one exists()
    // costs ~12 expressions and the 12-a-side create needed the room. (A side of 3+ players – every side once
    // scoring starts – skips the size tests.)
    function byNumberUsersOk(p) {
      return p.size() >= 3
        ? exists(/databases/$(database)/documents/users/$(p[0].id)) && exists(/databases/$(database)/documents/users/$(p[1].id))
          && exists(/databases/$(database)/documents/users/$(p[2].id))
        : (p.size() <= 0 || exists(/databases/$(database)/documents/users/$(p[0].id)))
          && (p.size() <= 1 || exists(/databases/$(database)/documents/users/$(p[1].id)));
    }
    function scoringStarted(d) { return d.status == 'live' || d.get('events', []).size() > 0; }
    function enoughPlayers(d) {
      return !scoringStarted(d)
        || (d.teamA.players.size() >= minPlayers() && d.teamB.players.size() >= minPlayers());
    }
    // (called only while there are no events – create, or a roster change before the first rally – so "scoring
    // started" is the live status; 1.4.4: both sides' ids are compared with participantIds in one slice)
    function validRoster(d) {
      return sideOk(d.teamA) && sideOk(d.teamB) && participantsOk(d)
        && rosterIdsOk(d.teamA.players, d.teamB.players, d.participantIds)
        && (d.status != 'live' || (d.teamA.players.size() >= minPlayers() && d.teamB.players.size() >= minPlayers()));
    }
    function rosterIdsOk(a, b, ids) {
      return a.size() + b.size() == 0 || ids[0:a.size() + b.size()] == playerIds(a).concat(playerIds(b));
    }
    function teamCanPlay(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds.size() >= minPlayers();
    }

    // ---------- 1.3.7 registration (src/core/registration.ts) ----------
    // Latin (incl. accented, no × ÷) and Devanagari letters/marks, space, apostrophe, hyphen; starts with a
    // letter; no doubled separators; 2–40 characters.
    function personNameOk(n) {
      return n is string && n.size() >= 2 && n.size() <= 40
        && n.matches('^[A-Za-z\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{24F}\\x{904}-\\x{939}\\x{950}\\x{958}-\\x{961}\\x{972}-\\x{97F}][A-Za-z\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{24F}\\x{900}-\\x{963}\\x{971}-\\x{97F}\\x{200C}\\x{200D}\\x{2019}\' -]*$')
        && !n.matches('.*[\\x{2019}\' -]{2,}.*') && !n.matches('.*[\\x{2019}\' -]$')
        // 1.3.7 (R136-10): ZWNJ/ZWJ only between Devanagari characters; no doubled virama
        && !n.matches('.*([^\\x{900}-\\x{97F}][\\x{200C}\\x{200D}]|[\\x{200C}\\x{200D}][^\\x{900}-\\x{97F}]|[\\x{200C}\\x{200D}]$|\\x{94D}\\x{94D}).*');
    }
    // Minimum age: MUST equal DEFAULT_MIN_AGE / MIN_AGE (10) used by the app and the API server.
    function minAge() { return 10; }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    // YYYY-MM-DD of today in IST, `years` years ago (string compare = date compare).
    function istYearsAgo(years) {
      let t = request.time + duration.value(330, 'm');
      return string(t.year() - years) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    function dobOk(d) {
      return d is string && d.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d <= istYearsAgo(minAge()) && d > istYearsAgo(101);
    }
    // oldDob = the stored DOB (null on create): re-saving the same DOB only needs a real date
    // (1.3.7, R136-8: turning 101 or a raised minAge() doesn't lock the owner out of their profile).
    // 1.4.0 (QA V139-3): one email per account. emails/{id} = {uid}; id = the stored email (the app stores it
    // NFC, trimmed, lower-case: core/registration.ts emailKey) with % and / escaped (emailClaimId). The doc
    // can only be created (never updated), so the first account to claim an address keeps it.
    // 1.4.3 (QA V142-5/V142-6): the vetted non-ASCII letters – src/core/emailChars.ts EMAIL_LETTERS_RULES, generated
    // by scripts/gen-email-chars.js, rules-tests check the copy. The characters themselves, not \\x{…}: Firestore
    // refuses a regular expression longer than 4096 characters.
    // <email-letters> GENERATED by scripts/gen-email-chars.js from src/core/emailPolicy.ts (NARROW list) – do not edit by hand
    function emailLetters() {
      return 'ß-öø-ÿāăąćĉċčďđēĕėęěĝğġģĥħĩīĭįıĳĵķ-ĸĺļľŀłńņň-ŉŋōŏőœŕŗřśŝşšţťŧũūŭůűųŵŷźżžƀƃƅƈƌ-ƍƒƕƙ-ƛƞơƣƥƨƪ-ƫƭưƴƶƹ-ƺƽ-ƿǆǉǌǎǐǒǔǖǘǚǜ-ǝǟǡǣǥǧǩǫǭǯ-ǰǳǵǹǻǽǿȁȃȅȇȉȋȍȏȑȓȕȗșțȝȟȡȣȥȧȩȫȭȯȱȳ-ȹȼȿ-ɀɂɇɉɋɍɏḁḃḅḇḉḋḍḏḑḓḕḗḙḛḝḟḡḣḥḧḩḫḭḯḱḳḵḷḹḻḽḿṁṃṅṇṉṋṍṏṑṓṕṗṙṛṝṟṡṣṥṧṩṫṭṯṱṳṵṷṹṻṽṿẁẃẅẇẉẋẍẏẑẓẕ-ẚẜ-ẝẟạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹỻỽỿͱͳͷͻ-ͽΐά-ρσ-ώϗϙϛϝϟϡϣϥϧϩϫϭϯϲ-ϳϸϻ-ϼἀ-ἇἐ-ἕἠ-ἧἰ-ἷὀ-ὅὐ-ὗὠ-ὧὰὲὴὶὸὺὼᾀ-ᾇᾐ-ᾗᾠ-ᾧᾰ-ᾴᾶ-ᾷῂ-ῄῆ-ῇῐ-ῒῖ-ῗῠ-ῢῤ-ῧῲ-ῴῶ-ῷа-џѡѣѥѧѩѫѭѯѱѳѵѷѹѻѽѿҁҋҍҏґғҕҗҙқҝҟҡңҥҧҩҫҭүұҳҵҷҹһҽҿӂӄӆӈӊӌӎ-ӏӑӓӕӗәӛӝӟӡӣӥӧөӫӭӯӱӳӵӷӹӻӽӿԁԃԅԇԉԋԍԏԑԓԕԗԙԛԝԟԡԣԥԧԩԫԭԯऀ-ॗॠ-ॣ०-९ॱ-ঃঅ-ঌএ-ঐও-নপ-রলশ-হ়-ৄে-ৈো-ৎৗৠ-ৣ০-ৱৼ৾ਁ-ਃਅ-ਊਏ-ਐਓ-ਨਪ-ਰਲਵਸ-ਹ਼ਾ-ੂੇ-ੈੋ-੍ੑੜ੦-ੵઁ-ઃઅ-ઍએ-ઑઓ-નપ-રલ-ળવ-હ઼-ૅે-ૉો-્ૐૠ-ૣ૦-૯ૹ-૿ଁ-ଃଅ-ଌଏ-ଐଓ-ନପ-ରଲ-ଳଵ-ହ଼-ୄେ-ୈୋ-୍୕-ୗୟ-ୣ୦-୯ୱஂ-ஃஅ-ஊஎ-ஐஒ-கங-சஜஞ-டண-தந-பம-ஹா-ூெ-ைொ-்ௐௗ௦-௯ఀ-ఌఎ-ఐఒ-నప-హ఼-ౄె-ైొ-్ౕ-ౖౘ-ౚౝౠ-ౣ౦-౯ಀ-ಃಅ-ಌಎ-ಐಒ-ನಪ-ಳವ-ಹ಼-ೄೆ-ೈೊ-್ೕ-ೖೝ-ೞೠ-ೣ೦-೯ೱ-ೳഀ-ഌഎ-ഐഒ-ൄെ-ൈൊ-ൎൔ-ൗൟ-ൣ൦-൯ൺ-ൿ';
    }
    function emailJoinOk(e) {
      return true; // the narrow list has no ZWNJ/ZWJ
    }
    // </email-letters>
    // a-z 0-9, the RFC 5322 atext signs (U+0027 as \\x{27}) and dots before the @; letters, digits, '-' and dots
    // after it; a TLD of 2+ letters/digits/'-'; plus emailLetters() in all three
    // 1.4.4 (QA V143-6): emailJoinOk – the wider list (inactive) allows ZWNJ/ZWJ only between letters of one
    // Indic script; with the 1.4.3 list it is true. 1.4.4 (QA V143-10): the structure checks the app makes
    // (core checkEmail): local part ≤ 64 characters without a leading, trailing or double dot; no double dot
    // anywhere; no domain label (or the domain) starting or ending with '-' or '.'. The class allows one '@' only,
    // so split('@') has two parts.
    function emailOk(e) {
      let l = emailLetters();
      return e.matches('^[-a-z0-9!#$%&\\x{27}*+/=?^_`{|}~.' + l + ']+@[-a-z0-9.' + l + ']+[.][-a-z0-9' + l + ']{2,}$')
        && emailJoinOk(e)
        && emailPartsOk(e.split('@'));
    }
    function emailPartsOk(p) {
      return p[0].size() <= 64 && !p[0].matches('[.].*|.*[.]') && !p[0].matches('.*[.][.].*')
        && !p[1].matches('[-.].*|.*[-.]|.*[.][.].*|.*[.]-.*|.*-[.].*');
    }
    function emailClaimId(e) {
      return e.replace('%', '%25').replace('/', '%2F');
    }
    function emailClaimedByMe(e) {
      let p = /databases/$(database)/documents/emails/$(emailClaimId(e));
      return existsAfter(p) && getAfter(p).data.uid == uid();
    }
    function oldClaimReleased(e) {
      let p = /databases/$(database)/documents/emails/$(emailClaimId(e));
      return !existsAfter(p) || getAfter(p).data.uid != uid();
    }
    function myEmailAfter() {
      return getAfter(/databases/$(database)/documents/users/$(uid())/private/registration).data.get('email', null);
    }
    // oldEmail = the stored email: an unchanged (or removed) address needs no claim, so a 1.3.7–1.3.9
    // account keeps its address; a new or changed one must be claimed by this user in the same write.
    function registrationOk(d, oldDob, oldEmail) {
      return d.keys().hasOnly(['dob', 'email', 'pincode', 'district', 'state', 'updatedAt'])
        && (d.get('email', null) == null || d.get('email', null) == oldEmail || emailClaimedByMe(d.email))
        // 1.4.1 (QA V140-5): changing or removing the address must release this account's claim on the old one
        // in the same write – one claim per account, so nobody can hoard addresses to block other people.
        && (oldEmail == null || d.get('email', null) == oldEmail ? true : oldClaimReleased(oldEmail))
        && (oldDob != null && d.get('dob', null) == oldDob
            ? d.dob.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            : dobOk(d.get('dob', null)))
        // 1.3.8 (V137-5): allocated India Post prefixes only (core/registration.ts PIN_PREFIX_RANGES 11-28,
        // 30-34, 36-53, 56-85, plus APS 90-99), as the API decides without a lookup
        && d.get('pincode', '').matches('^(1[1-9]|2[0-8]|3[0-4]|3[6-9]|4[0-9]|5[0-3]|5[6-9]|6[0-9]|7[0-9]|8[0-5]|9[0-9])[0-9]{4}$')
        // 1.4.3 (QA V142-5/V142-6, FB-9): an ALLOW list, not a deny list – the deny lists kept missing characters
        // (RE2's \p{Lu} is older than the app's Unicode, format characters U+FFF9–FFFB / U+0600–0605 / U+13430…).
        // Local part: a-z 0-9, the RFC 5322 atext signs (U+0027 is \x{27}) and dots; domain: letters, digits, '-',
        // dots; plus the vetted letters of src/core/emailChars.ts (lower-case Latin/Greek/Cyrillic Ll, Indian
        // scripts' letters, marks and digits; NFC-stable, already folded), copied here by scripts/gen-email-chars.js
        // and compared by rules-tests. So no capital, no format/control/private-use/unassigned/separator character
        // can pass, and the app (core checkEmail: same class) refuses everything this refuses, with a message.
        // 1.4.4 (QA V143-6): the account's own unchanged stored address always passes (it was accepted when saved;
        // a stricter list must not block a pincode or name save); a new or changed one gets every check.
        && (d.get('email', null) == null || d.get('email', null) == oldEmail || (d.email is string && d.email.size() <= 254 && emailOk(d.email)))
        // 1.3.8 (V137-5): like the API, a district/state typed by the client is never stored (the API keeps
        // only its own India Post lookup; Firebase has no server lookup, so it stores none)
        && d.get('district', null) == null && d.get('state', null) == null;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if signedIn();
      // Fields as src/core/types.ts UserProfile (pushToken: legacy docs only). No role/admin fields.
      function profileOk(d, ks) {
        return d.keys().hasOnly(['id', 'name', 'phone', 'photoURL', 'position', 'city', 'pushToken', 'createdAt', 'updatedAt', 'firstName', 'lastName'])
          && (!ks.hasAny(['firstName']) || personNameOk(d.firstName))
          && (!ks.hasAny(['lastName']) || personNameOk(d.lastName))
          && (!ks.hasAny(['name']) || nameOk(d.name, 2, 60))
          && (!ks.hasAny(['city']) || optTextOk(d.get('city', null), 80))
          && (!ks.hasAny(['position']) || d.get('position', null) == null
              || d.position in ['setter', 'outside', 'middle', 'opposite', 'libero', 'any'])
          && (!ks.hasAny(['photoURL']) || d.get('photoURL', null) == null || photoUrlOk(d.photoURL, 'avatars%2F' + userId + '%2F'))
          && (!ks.hasAny(['id']) || d.id == userId)
          && (!ks.hasAny(['createdAt']) || optMsOk(d.get('createdAt', null)));
      }
      // The Indian format is required when the number is set or changed. A profile from before
      // build 216 with another number can still be edited while it stays the same (fix-retest N4).
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.phone == myPhone()
        && (validPhone(request.resource.data.phone) || (resource != null && resource.data.phone == request.resource.data.phone))
        && request.resource.data.name is string
        && profileOk(request.resource.data, writtenKeys())
        && termsOk();
      allow delete: if false;

      // 1.3.7 (1.3.6 registration): date of birth, email, pincode, district and state are private – only
      // the owner reads or writes them (the profile doc above is readable by every signed-in user).
      // Same checks as src/core/registration.ts: real past date, age minAge()..100 in IST, optional
      // email, pincode ^[1-9][0-9]{5}$ (the India Post lookup happens in the app / API server only).
      // 1.3.9 (V137-4): the in-app review prompt's clock (services/review.ts, firebaseBackend.reviewClock):
      // lastAskedAt (when we last asked) and checkedAt (written just to read the server's "now") are server
      // timestamps – each is either unchanged or exactly request.time, so the 60-day check never uses the phone clock.
      function stampOk(d, old, k) {
        return d.get(k, null) == (old == null ? null : old.get(k, null)) || d.get(k, null) == request.time;
      }
      function reviewClockOk(d, old) {
        return d.keys().hasOnly(['checkedAt', 'lastAskedAt']) && stampOk(d, old, 'checkedAt') && stampOk(d, old, 'lastAskedAt');
      }
      match /private/{docId} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && ((docId == 'registration'
          && registrationOk(request.resource.data, resource == null ? null : resource.data.get('dob', null), resource == null ? null : resource.data.get('email', null)))
          || (docId == 'review' && reviewClockOk(request.resource.data, resource == null ? null : resource.data)));
        allow delete: if false;
      }
    }

    // T&C acceptance (1.3.0): own doc only, exactly the current version, acceptedAt = server time,
    // only forward (an older version can be replaced; the current one is never rewritten), no delete.
    match /terms/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list: if false;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.version == termsVersion()
        && request.resource.data.acceptedAt == request.time
        && (resource == null || resource.data.version != termsVersion());
      allow delete: if false;
    }

    // Private push token per user (read by Cloud Functions with admin access).
    match /pushTokens/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // 1.4.0 (QA V139-3): email claims (see emailClaimId). Read: only your own claim, or "no such claim"
    // (the app reads it in the save transaction; someone else's claim is refused → "email already used").
    // Created only for the email the same write stores in your registration doc; released (deleted) only by
    // the owner when that doc no longer holds it; never updated, never listed.
    match /emails/{claimId} {
      allow get: if signedIn() && (resource == null || resource.data.uid == uid());
      allow list: if false;
      allow create: if signedIn() && termsOk()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid()
        && myEmailAfter() != null && emailClaimId(myEmailAfter()) == claimId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == uid()
        && (myEmailAfter() == null || emailClaimId(myEmailAfter()) != claimId);
    }

    // Lookup by mobile number: exact get only, listing is forbidden.
    match /phoneIndex/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && phone == myPhone()
        && (validPhone(phone) || (resource != null && resource.data.uid == uid()))
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == uid()
        && termsOk();
      allow delete: if false;
    }

    // ---------- teams ----------
    match /teams/{teamId} {
      function isCaptain() { return resource.data.captainId == uid(); }

      function acceptingInvite() {
        return myPhone() in resource.data.pendingPhones
          && changed().hasOnly(['memberIds', 'pendingPhones', 'subIds'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([uid()].toSet())
          && request.resource.data.pendingPhones.toSet() == resource.data.pendingPhones.toSet().difference([myPhone()].toSet())
          && request.resource.data.subIds.toSet().difference(resource.data.subIds.toSet()).hasOnly([uid()]);
      }
      function decliningInvite() {
        return myPhone() in resource.data.pendingPhones
          && changed().hasOnly(['pendingPhones'])
          && request.resource.data.pendingPhones.toSet() == resource.data.pendingPhones.toSet().difference([myPhone()].toSet());
      }
      function leaving() {
        return uid() in resource.data.memberIds
          && !isCaptain()
          && changed().hasOnly(['memberIds', 'subIds'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
          && request.resource.data.subIds.toSet() == resource.data.subIds.toSet().difference([uid()].toSet());
      }

      // Captains may only invite numbers that are already registered (present in
      // phoneIndex). At most one new number per write, appended at the end of the list
      // (the app and arrayUnion both append), so the rule can check it.
      function invitesOnlyRegistered() {
        let before = resource.data.pendingPhones.toSet();
        let after = request.resource.data.pendingPhones;
        let added = after.toSet().difference(before);
        return added.size() == 0
          || (added.size() == 1
              && added.hasOnly([after[after.size() - 1]])
              && validPhone(after[after.size() - 1])
              && exists(/databases/$(database)/documents/phoneIndex/$(after[after.size() - 1])));
      }

      function teamOk(d, ks) {
        return d.keys().hasOnly(['name', 'nameLower', 'color', 'captainId', 'memberIds', 'subIds', 'pendingPhones', 'city', 'createdAt', 'updatedAt'])
          && (!ks.hasAny(['name']) || nameOk(d.name, 2, 40))
          && (!ks.hasAny(['nameLower']) || (d.nameLower is string && d.nameLower.size() <= 40))
          && (!ks.hasAny(['color']) || colorOk(d.color))
          && (!ks.hasAny(['city']) || optTextOk(d.get('city', null), 80))
          && (!ks.hasAny(['subIds']) || (d.subIds is list && d.subIds.size() <= 12))
          && (!ks.hasAny(['createdAt']) || msOk(d.createdAt));
      }
      allow read: if signedIn();
      allow create: if signedIn() && termsOk()
        && request.resource.data.captainId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.pendingPhones.size() == 0
        && request.resource.data.name is string
        && teamOk(request.resource.data, writtenKeys());
      allow update: if signedIn() && termsOk() && (
        (isCaptain()
          && teamOk(request.resource.data, writtenKeys())
          && request.resource.data.captainId in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 12
          // members join only by accepting an invite (PRD TEAM-05); the captain can remove, not add
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && request.resource.data.pendingPhones.size() <= 12
          && invitesOnlyRegistered())
        || acceptingInvite()
        || decliningInvite()
        || leaving()
      );
      allow delete: if signedIn() && isCaptain() && termsOk();
    }

    // ---------- matches ----------
    // ---------- match documents (QA G1) ----------
    // Same limits as the API (server/src/domain/schemas.ts). Only fields being written are checked
    // (on update: the changed ones), so an older document can still be scored or closed.
    // Rules can't loop over events, so the event log may only change by ONE scorer step per write
    // (QA G1, retest 217): append 1 event (shape-checked at its index), undo exactly the last
    // event, or change the player credit / shot type of one of the last 3 events (same rally:
    // type, side and time unchanged). Everything before is compared as a whole with the stored
    // log (one list comparison). One appended event per write (not 2-3) keeps a finishing write on
    // a 12-a-side match with a long log inside the 1000-expression budget (rules-tests "G1 budget").
    // The app writes a longer change (e.g. a log restored after a long time offline) as a sequence
    // of such steps (src/core/eventSteps.ts, firebaseBackend.saveMatchProgress); the API server
    // replays every event instead.
    // One regex for type, side, shot type and credited player (each reference to e re-evaluates
    // the list element passed in, so the checks are packed into few expressions).
    function eventOk(e, d) {
      return e.keys().hasOnly(['type', 'side', 'at', 'playerId', 'kind'])
        && (e.type + '|' + e.side + '|' + string(e.get('kind', null)) + '|' + string(e.get('playerId', null)))
             .matches('^(point|timeout)[|][AB][|](kill|block|ace|tip|null)[|]([A-Za-z0-9_-]{1,128}|null)$')
        && e.at is int && e.at >= 0 && e.at <= nowMs() + 86400000
        && creditOk(e, d);
    }
    // QA NB-R5 (retest 1.1.0): a credited player must be on the side that won the rally.
    // 1.3.4 (QA D133-5) LIMIT: "on court right now" is NOT checked here. It needs the rotation replayed
    // from every event plus the set lineups (core/rotation.ts offCourtCredit), which rules can't do
    // (no loops). The API server and the demo backend refuse a bench credit (not_on_court); with
    // Firebase the scorer app only offers on-court chips, and the credit is still limited to a
    // player of the team that won the rally.
    // participantIds start with exactly team A's players, then team B's (participantsOk).
    // (Arguments are re-evaluated at every reference, so the values are passed down once each.)
    function creditOk(e, d) {
      return e.get('playerId', null) == null ? true
        : creditIn(e.playerId, e.side, d.teamA.players.size(), d.teamB.players.size(), d.participantIds);
    }
    function creditIn(p, side, na, nb, ids) {
      return p in (side == 'A' ? ids[0:na] : ids[na:na + nb]);
    }
    // 1.4.4: the two events are passed, not the whole logs – every function argument is a variable, and binding the
    // long event lists for each of the last 3 rallies ran into the rules' 5 MiB variable-memory limit.
    function sameRally(ne, oe, d) {
      return eventOk(ne, d) && ne.type == oe.type && ne.side == oe.side && ne.at == oe.at;
    }
    // Both sides of || and && are evaluated by the rules engine (only ?: skips a branch), so the
    // step kind is picked with ?: and only its checks run. (An empty slice like l[0:0] is an
    // evaluation error, hence the size tests.)
    function appendOk(o, n, os, ns, d) {
      let e = n[os];
      return ns == os + 1 && (os == 0 ? true : n[0:os] == o) && eventOk(e, d);
    }
    function recreditOk(o, n, ns, d) {
      return ns > 0 && (ns > 3 ? n[0:ns - 3] == o[0:ns - 3] : true)
        && recreditOne(n[ns - 1], o[ns - 1], d) && (ns >= 2 ? recreditOne(n[ns - 2], o[ns - 2], d) : true) && (ns >= 3 ? recreditOne(n[ns - 3], o[ns - 3], d) : true);
    }
    // Only an event that actually changed is re-checked.
    function recreditOne(ne, oe, d) {
      return ne == oe ? true : sameRally(ne, oe, d);
    }
    // (let: each size is evaluated once; 1.3.0 needed the room in the 1000-expression budget.)
    function eventsStepOk(o, n, d) {
      let os = o.size();
      let ns = n.size();
      // 1.4.4 (QA info): 3000 events (was 2000, which a legal long uncapped deuce match can reach) = MAX_EVENTS in
