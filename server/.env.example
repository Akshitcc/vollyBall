# VolleyLive API server configuration. Copy to `.env` and fill in real values locally.
# Never commit `.env`. Everything below is a PLACEHOLDER.

NODE_ENV=development
PORT=4000

# MySQL 8.x connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# (add ?socket=/path/to/mysqld.sock to use a unix socket)
DATABASE_URL=mysql://volleylive:CHANGE_ME@127.0.0.1:3306/volleylive
# Only used by `npm test`. The database name MUST end in _test: the tests drop and recreate every table.
TEST_DATABASE_URL=mysql://volleylive:CHANGE_ME@127.0.0.1:3306/volleylive_test
# Run pending migrations when the server starts (1 = yes). The Docker image runs them on every start
# through docker/start.sh instead (MIGRATE_ON_DEPLOY=1, the default there; 0 = skip).
MIGRATE_ON_START=0
MIGRATE_ON_DEPLOY=1

# TLS to a managed MySQL (DigitalOcean, Aiven, RDS, PlanetScale, Railway…). DB_SSL=1 requires TLS;
# give the provider's CA certificate either as text (DB_SSL_CA, "\n" for newlines) or as a file path.
DB_SSL=0
DB_SSL_CA=
DB_SSL_CA_FILE=
# Only for a provider whose certificate can't be verified (not recommended)
DB_SSL_REJECT_UNAUTHORIZED=1

# Authentication.
#   otp      – the API runs sign-in itself: OTP_PROVIDER sends the SMS code (msg91) or Firebase Phone
#              Auth does it on the phone (firebase); the API then issues its own session tokens.
#   firebase – every request carries a Firebase phone-auth ID token.
#   dev      – see below (local only).
# "firebase" verifies Firebase phone-auth ID tokens (production).
# "dev" accepts tokens of the form dev:+919876543210 with NO verification. Local testing only;
# the server refuses to start with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=firebase
# Firebase project id (public, the same as EXPO_PUBLIC_FIREBASE_PROJECT_ID). No service-account key is
# needed to verify ID tokens.
FIREBASE_PROJECT_ID=your-project-id

# --- AUTH_MODE=otp ---
# msg91 | firebase | dev   (dev = no SMS, code always 123456; refused when NODE_ENV=production)
OTP_PROVIDER=dev
# Signs session tokens and keys the OTP/phone hashes: at least 32 random characters
# (e.g. `openssl rand -hex 32`). Required in production. Changing it signs everyone out.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
# OTP limits (defaults shown)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
OTP_IP_PER_HOUR=20
# MSG91 (OTP_PROVIDER=msg91): auth key from the MSG91 panel and the DLT-approved Flow template id.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Name of the variable in the template that holds the code, e.g. ##otp##
MSG91_OTP_VAR=otp

# Photo storage: local (disk, STORAGE_DIR) or s3 (any S3-compatible store: Cloudflare R2, AWS S3,
# DigitalOcean Spaces, Backblaze B2, MinIO). The app always gets signed, expiring /files/... links;
# with s3 the API checks the link and redirects to a short-lived presigned URL (bucket stays private).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   AWS: https://s3.ap-south-1.amazonaws.com
S3_ENDPOINT=
S3_BUCKET=
# "auto" for R2, e.g. ap-south-1 for AWS Mumbai
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=1
# 1 = /files redirects to a presigned URL (default); 0 = the API streams the bytes
S3_REDIRECT=1
S3_PRESIGN_SECONDS=300
# Base URL the app uses to reach this server (used to build photo URLs)
PUBLIC_BASE_URL=http://localhost:4000
# HMAC key for photo URLs, at least 32 random characters (e.g. `openssl rand -hex 32`). Required in production.
FILE_URL_SECRET=replace-with-at-least-32-random-characters
FILE_URL_TTL_SECONDS=604800

# Comma-separated browser origins allowed by CORS (Expo web dev server, your web host). The Android app
# sends no Origin and doesn't need this. In production "*" and http:// origins are refused.
CORS_ORIGINS=http://localhost:8081

# Rate limits: in memory by default (correct for ONE instance). Set a Redis URL (redis:// or rediss://)
# to share them when running more than one instance.
REDIS_URL=

# Behind a platform load balancer / reverse proxy: the number of proxies in front (Railway/Render/Caddy: 1)
TRUST_PROXY=loopback
# JSON logs: error | warn | info | debug | silent
LOG_LEVEL=info

# 1.3.0 anti-fraud: Firebase uids allowed to review flagged matches (approve/void) and delete
# finished matches. Comma-separated uids of EXISTING accounts; no accounts or keys are created.
ADMIN_UIDS=

# Push notifications through the Expo push service (1 = send, 0 = disabled)
PUSH_ENABLED=1
# Only needed if "Enhanced push security" is turned on for your Expo project
EXPO_ACCESS_TOKEN=

# 1.3.7: pincode → district lookup (public India Post API, api.postalpincode.in; no key). 0 = off:
# pincodes are then checked by format and allocated prefix only, and saved without a district.
PINCODE_LOOKUP=1
# Minimum age at registration (whole years, default 10). Keep it equal to the app's EXPO_PUBLIC_MIN_AGE.
MIN_AGE=

# 1.4.20 Ask VolleyLive (Help Center chat). mock = no AI (answers quote the matching FAQ / rule note).
# openai | gemini | anthropic need ASK_API_KEY (set in the host's secret store; never commit it).
ASK_PROVIDER=mock
ASK_API_KEY=
ASK_MODEL=
