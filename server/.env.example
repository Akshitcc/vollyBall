# VolleyLive API server configuration. Copy to `.env` and fill in real values locally.
# Never commit `.env`. Everything below is a PLACEHOLDER.

NODE_ENV=development
PORT=4000

# MySQL 8.x connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# (add ?socket=/path/to/mysqld.sock to use a unix socket)
DATABASE_URL=mysql://volleylive:CHANGE_ME@127.0.0.1:3306/volleylive
# Only used by `npm test`. The database name MUST end in _test: the tests drop and recreate every table.
TEST_DATABASE_URL=mysql://volleylive:CHANGE_ME@127.0.0.1:3306/volleylive_test
# Run pending migrations when the server starts (1 = yes)
MIGRATE_ON_START=0

# Authentication. "firebase" verifies Firebase phone-auth ID tokens (production).
# "dev" accepts tokens of the form dev:+919876543210 with NO verification. Local testing only;
# the server refuses to start with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=firebase
# Firebase project id (public, the same as EXPO_PUBLIC_FIREBASE_PROJECT_ID). No service-account key is
# needed to verify ID tokens.
FIREBASE_PROJECT_ID=your-project-id

# Photo storage (local disk). Files are served at /files/... through signed, expiring URLs.
STORAGE_DIR=./uploads
# Base URL the app uses to reach this server (used to build photo URLs)
PUBLIC_BASE_URL=http://localhost:4000
# HMAC key for photo URLs, at least 32 random characters (e.g. `openssl rand -hex 32`). Required in production.
FILE_URL_SECRET=replace-with-at-least-32-random-characters
FILE_URL_TTL_SECONDS=604800

# Comma-separated browser origins allowed by CORS (Expo web dev server, your web host)
CORS_ORIGINS=http://localhost:8081

# 1.3.0 anti-fraud: Firebase uids allowed to review flagged matches (approve/void) and delete
# finished matches. Comma-separated uids of EXISTING accounts; no accounts or keys are created.
ADMIN_UIDS=

# Push notifications through the Expo push service (1 = send, 0 = disabled)
PUSH_ENABLED=1
# Only needed if "Enhanced push security" is turned on for your Expo project
EXPO_ACCESS_TOKEN=
