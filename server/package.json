{
  "name": "volleylive-server",
  "version": "1.0.0",
  "private": true,
  "description": "VolleyLive API: Express + Knex (MySQL 8) + WebSocket live scoreboard. Firebase is used only to verify phone-OTP ID tokens and push goes through Expo.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
