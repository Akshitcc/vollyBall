{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../src/core/**/*.ts"],
  "exclude": ["../src/core/__tests__/**", "dist", "node_modules"]
}
