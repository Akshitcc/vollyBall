# Copy this file to `.env` and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app (SDK setup and configuration).
# Leave EXPO_PUBLIC_FIREBASE_API_KEY empty to run the app in offline DEMO MODE (sample data, OTP 123456).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# VolleyLive API server (server/). Set this to use the MySQL backend instead of Firestore,
# e.g. http://192.168.1.10:4000 (your computer's LAN IP when testing on a phone).
EXPO_PUBLIC_API_URL=
# Local testing only: sign in to the API with any number and OTP 123456, without Firebase.
# The server must run with AUTH_MODE=dev. Never use this for a real deployment.
EXPO_PUBLIC_API_DEV_AUTH=0

# Force demo mode even if Firebase keys are present (1 = on)
EXPO_PUBLIC_DEMO_MODE=0

# Optional: say which backend this build must use (demo | api | firebase). With "api" the build
# FAILS (expo config / bundling and app start) when EXPO_PUBLIC_API_URL is missing, instead of
# quietly becoming a demo build whose sign-ups stay on the phone. EXPO_PUBLIC_API_DEV_AUTH=1 or a
# set EXPO_PUBLIC_API_URL also count as asking for the API. Profile > About shows the result.
EXPO_PUBLIC_BACKEND=

# Phone numbers are Indian mobiles only (+91, fixed in src/core/phone.ts); no country-code setting.

# --- Build-time only (not bundled into the app) ---
# EAS project id (from `npx eas-cli@latest init`) – required for Expo push tokens
EAS_PROJECT_ID=
# Google Maps key for Android builds (Expo Go does not need it)
GOOGLE_MAPS_ANDROID_API_KEY=
# Path to google-services.json for Android FCM push (e.g. ./google-services.json)
GOOGLE_SERVICES_JSON=
IOS_BUNDLE_ID=com.volleylive.app
ANDROID_PACKAGE=com.volleylive.app

# --- 1.3.7 launch prep (placeholders only; leave empty or as shown) ---
# How API mode signs in: otp (the server sends the SMS code), firebase (Firebase phone auth on the
# phone) or dev (local only, refused in production builds). Empty = decided from the other settings.
EXPO_PUBLIC_API_AUTH=
# 1 = leave the demo backend, seed data and QA tools out of the bundle (the EAS "production" profile
# sets this). Production builds refuse to start without it. Check: npm run check:strip
EXPO_PUBLIC_STRIP_DEMO=0
# production = production build checks (no demo, no dev sign-in, empty demo admins). Set by EAS.
APP_VARIANT=
# Minimum age at registration (whole years, default 10). Keep it equal to the server's MIN_AGE.
EXPO_PUBLIC_MIN_AGE=
# DEMO ONLY: comma-separated demo user ids that may use admin screens. Must be empty in production.
EXPO_PUBLIC_DEMO_ADMIN_UIDS=
# Shown in Profile/registration help and "Send feedback" (e.g. support@example.com). Empty = hidden.
EXPO_PUBLIC_SUPPORT_EMAIL=
# 1 = show our own "Enjoying VolleyLive?" question before the Play/App Store review sheet.
# Keep 0: Google Play policy forbids filtering/gating who gets the review prompt (src/services/review.ts).
EXPO_PUBLIC_REVIEW_PREPROMPT=0
