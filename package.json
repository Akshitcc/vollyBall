{
  "name": "volleylive",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.0.0",
    "i18next": "^26.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:tz": "for z in UTC Asia/Kolkata America/Los_Angeles Pacific/Kiritimati; do echo \"== TZ=$z\"; TZ=$z jest --silent || exit 1; done",
    "check:strip": "node scripts/check-strip.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/core/__tests__/**/*.test.ts",
      "**/src/i18n/__tests__/**/*.test.ts?(x)",
      "**/src/components/__tests__/**/*.test.ts?(x)",
      "**/src/services/__tests__/**/*.test.ts?(x)",
      "**/src/theme/__tests__/**/*.test.ts?(x)",
      "**/src/app/__tests__/**/*.test.ts?(x)"
    ],
    "testTimeout": 15000,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
